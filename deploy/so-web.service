[Unit]
Description=SecondOpinion web
After=network.target

[Service]
User=so
WorkingDirectory=/opt/secondopinion/app
EnvironmentFile=/etc/secondopinion.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
ExecStart=/opt/secondopinion/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
